#include <vcl.h>
#pragma hdrstop

#include "Unit10.h"
#include "URegionFF.h"

#include "DataModule.h"
//---------------------------------------------------------------------------
#pragma package(smart_init)
#pragma resource "*.dfm"
TForm10 *Form10;
//---------------------------------------------------------------------------
__fastcall TForm10::TForm10(TComponent* Owner)
	: TForm(Owner)
{
}
//---------------------------------------------------------------------------
void __fastcall TForm10::Edit1Change(TObject *Sender)
{
    String filterText = Edit1->Text;

	DataModule2->FDQuery9->Close();

	if (!filterText.IsEmpty() && filterText != "Поиск...")
	{
		DataModule2->FDQuery9->ParamByName("RegionsFilter")->AsString = "%" + filterText + "%";
    }
	else
	{
		DataModule2->FDQuery9->ParamByName("RegionsFilter")->AsString = "%";
    }

	DataModule2->FDQuery9->Open();

    // Обновляем StatusBar с количеством записей
	StatusBar1->Panels->Items[0]->Text = "Количество записей: " + IntToStr(DataModule2->FDQuery9->RecordCount);
}
//---------------------------------------------------------------------------
void __fastcall TForm10::Edit1Enter(TObject *Sender)
{
    // Если текст "Поиск...", очищаем поле
	if (Edit1->Text == "Поиск...")
    {
		Edit1->Text = "";
    }
}
//---------------------------------------------------------------------------
void __fastcall TForm10::Edit1Exit(TObject *Sender)
{
    // Если поле пустое, устанавливаем текст "Поиск..."
	if (Edit1->Text.IsEmpty())
    {
		Edit1->Text = "Поиск...";
	}
}
//---------------------------------------------------------------------------
void __fastcall TForm10::Button1Click(TObject *Sender)
{
	FRegionFF->ShowModal();
}
//---------------------------------------------------------------------------
void __fastcall TForm10::Button2Click(TObject *Sender)
{
    DataModule2->FDTransaction1->StartTransaction();
	DataModule2->FDQuery9->Append();
	FRegionFF->ShowModal();
}
//---------------------------------------------------------------------------
void __fastcall TForm10::Button3Click(TObject *Sender)
{
    DataModule2->FDQuery9->Delete();
}
//---------------------------------------------------------------------------
void __fastcall TForm10::FormShow(TObject *Sender)
{
	DataModule2->FDQuery9->Open();
	StatusBar1->Panels->Items[0]->Text = "Количество записей: " + IntToStr(DataModule2->FDQuery9->RecordCount);
}
//---------------------------------------------------------------------------

