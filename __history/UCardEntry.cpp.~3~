void __fastcall TFCardEntry::UpdateQuery()
{
	// Закрываем запрос, если он открыт
	if (DataModule2->FDQuery5->Active)
	{
		DataModule2->FDQuery5->Close();
	}

	DataModule2->FDQuery5->ParamByName("RecID")->AsInteger = this->recID;

	DataModule2->FDQuery5->Open();

	TotalCost();
}

void __fastcall TFCardEntry::TotalCost()
{
	Currency totalCost = 0.0;

	if (!DataModule2->FDQuery5->Active || DataModule2->FDQuery5->IsEmpty()) {
		return;
    }

    while (!DataModule2->FDQuery5->Eof) {
        double price = DataModule2->FDQuery5->FieldByName("Price")->AsFloat;
        int count = DataModule2->FDQuery5->FieldByName("Count")->AsInteger;

        totalCost += price * count;

        DataModule2->FDQuery5->Next();
    }

    if (DataModule2->FDQuery5->RecordCount > 0) {
		DataModule2->FDQuery5->Edit();
		DataModule2->FDQuery5->FieldByName("Sum")->AsCurrency = totalCost;
        DataModule2->FDQuery5->Post();
    } else {
        ShowMessage("Нет записей для обновления суммы.");
	}
}

