void __fastcall TFCardEntry::SetDoctorID(int SelectedDoctorID, TDateTime selectedDate)
{
	// Сохраняем SelectedDoctorID
	this->SelectedDoctorID = SelectedDoctorID;

	this->selectedDate = selectedDate;

   	// 1. Создаем новую запись в inf_Records
	DataModule2->FDQuery6->SQL->Clear();
	DataModule2->FDQuery6->SQL->Add("INSERT INTO inf_Records (employee) VALUES (:DoctorID)");
	DataModule2->FDQuery6->ParamByName("DoctorID")->AsInteger = SelectedDoctorID;
	DataModule2->FDQuery6->ExecSQL();

	// 2. Получаем новый IRecID
    DataModule2->FDQuery6->SQL->Clear();
	DataModule2->FDQuery6->SQL->Add("SELECT MAX(IRecID) AS NewIRecID FROM inf_Records");
	DataModule2->FDQuery6->Open();

	newIRecID = DataModule2->FDQuery6->FieldByName("NewIRecID")->AsInteger;

    // 3. Создаем новую запись в Records
	DataModule2->FDQuery6->SQL->Clear();
	DataModule2->FDQuery6->SQL->Add("INSERT INTO Records (Description, `Date`) VALUES (:Description, :Date)");
	DataModule2->FDQuery6->ParamByName("Description")->AsInteger = newIRecID; // Используем новый IRecID
	DataModule2->FDQuery6->ParamByName("Date")->AsDateTime  = selectedDate;
	DataModule2->FDQuery6->ExecSQL();


    DataModule2->FDQuery1->Close();
    DataModule2->FDQuery1->Open();
	DataModule2->FDQuery1->Last();

	recID = DataModule2->FDQuery1->FieldByName("RecID")->AsInteger;

	PopulateTimeComboBox();
	UpdateQuery();
	UpdateQueryMed();
    UpdateQueryAil();
}

