void __fastcall TFCardEntry::PopulateTimeComboBox()
{
    // Очищаем существующие элементы в ComboBox1
	ComboBox1->Items->Clear();

    // Получаем дату и время из Record
	TDateTime selectedDate = DataModule2->FDQuery1->FieldByName("Дата")->AsDateTime;
	TDateTime startTime = selectedDate + 8.0 / 24.0; // 8:00:00
	TDateTime endTime = selectedDate + 14.0 / 24.0;  // 14:00:00
	TDateTime currentTime = startTime;

    // Запрос для получения существующих бронирований на выбранную дату
	TStringList *bookedTimes = new TStringList();
    String defaultTime;
    try
    {
		// Предполагаем, что FDQuery настроен для получения забронированных времен
		DataModule2->FDQuery6->SQL->Text =
			"SELECT Time FROM Records WHERE Date = :Date"
			" AND (Select employee from inf_Records where IRecID = Description) = :DocID";

		DataModule2->FDQuery6->ParamByName("Date")->AsDateTime = selectedDate;
		DataModule2->FDQuery6->ParamByName("DocID")->AsInteger = this->SelectedDoctorID;
		DataModule2->FDQuery6->Open();

		#ifdef DEBUG
			Memo1->Lines->Add("ID: " + IntToStr(this->SelectedDoctorID));
		#endif

		while (!DataModule2->FDQuery6->Eof)
		{
			bookedTimes->Add(DataModule2->FDQuery6->FieldByName("Time")->AsString);
			DataModule2->FDQuery6->Next();
        }
    }
    __finally
    {
		DataModule2->FDQuery6->Close();
    }

    // Заполняем ComboBox1 доступными временами
    while (currentTime < endTime)
    {
        String timeString = currentTime.FormatString("hh:nn:ss");
        if (!bookedTimes->Contains(timeString))
        {
            ComboBox1->Items->Add(timeString);
        }
        currentTime = currentTime + (30.0 / 1440.0);
	}

	delete bookedTimes;
}

void __fastcall TFCardEntry::ComboBox1Change(TObject *Sender)
{
    // Получаем выбранное время из ComboBox
    String selectedTime = ComboBox1->Text;

    // Обновляем поле "Время" в таблице Records
    try
    {
        DataModule2->FDQuery1->Edit(); // Переходим в режим редактирования
        DataModule2->FDQuery1->FieldByName("Время")->AsString = selectedTime; // Устанавливаем только время как строку
        DataModule2->FDQuery1->Post(); // Сохраняем изменения
    }
    catch (const Exception &e)
    {
        ShowMessage("Ошибка при обновлении времени: " + e.Message);
    }
}
