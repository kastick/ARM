//---------------------------------------------------------------------------

#include <vcl.h>
#pragma hdrstop

#include "Unit18.h"
#include "Unit19.h"
#include "DataModule.h"
//---------------------------------------------------------------------------
#pragma package(smart_init)
#pragma resource "*.dfm"
TForm18 *Form18;
//---------------------------------------------------------------------------
__fastcall TForm18::TForm18(TComponent* Owner)
	: TForm(Owner)
{
}
//---------------------------------------------------------------------------
void __fastcall TForm18::Button1Click(TObject *Sender)
{
     Form19->ShowModal();
}
//---------------------------------------------------------------------------
void __fastcall TForm18::Button2Click(TObject *Sender)
{
    DataModule2->FDTransaction1->StartTransaction();
	DataModule2->FDQuery16->Append();
	Form19->ShowModal();
}
//---------------------------------------------------------------------------
void __fastcall TForm18::Button3Click(TObject *Sender)
{
    DataModule2->FDQuery16->Delete();
}
//---------------------------------------------------------------------------
void __fastcall TForm18::Edit1Change(TObject *Sender)
{
    String filterText = Edit1->Text;

	DataModule2->FDQuery16->Close();

	if (!filterText.IsEmpty() && filterText != "Поиск...")
	{
		DataModule2->FDQuery16->ParamByName("SpecialtiesFilter")->AsString = "%" + filterText + "%";
    }
	else
	{
		DataModule2->FDQuery16->ParamByName("SpecialtiesFilter")->AsString = "%";
    }

	DataModule2->FDQuery16->Open();

    // Обновляем StatusBar с количеством записей
	StatusBar1->Panels->Items[0]->Text = "Количество записей: " + IntToStr(DataModule2->FDQuery16->RecordCount);
}
//---------------------------------------------------------------------------
void __fastcall TForm18::Edit1Enter(TObject *Sender)
{
    // Если текст "Поиск...", очищаем поле
	if (Edit1->Text == "Поиск...")
    {
		Edit1->Text = "";
	}
}
//---------------------------------------------------------------------------
void __fastcall TForm18::Edit1Exit(TObject *Sender)
{
    // Если поле пустое, устанавливаем текст "Поиск..."
	if (Edit1->Text.IsEmpty())
    {
		Edit1->Text = "Поиск...";
	}
}
//---------------------------------------------------------------------------
void __fastcall TForm18::FormShow(TObject *Sender)
{
	DataModule2->FDQuery16->Open();
	StatusBar1->Panels->Items[0]->Text = "Количество записей: " + IntToStr(DataModule2->FDQuery16->RecordCount);
}
//---------------------------------------------------------------------------
